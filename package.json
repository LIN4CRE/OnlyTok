{
  "name": "onlytok",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ONLYTOK — creator discovery & entertainment brand site for @onlytokgirls (React + Vite SPA with optional Express API).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "build:all": "npm run build && npm run build:server",
    "start": "node server.js",
    "preview": "vite preview",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist server.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "firebase": "^13.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
